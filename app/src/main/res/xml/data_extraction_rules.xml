<?xml version="1.0" encoding="utf-8"?>
<!-- Третий слой бэкапа: Android сам копирует базу и настройки в облако и переносит их на новый телефон -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
